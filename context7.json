{
  "$schema": "https://context7.com/schema/context7.json",
  "projectTitle": "OxidizePdf.NET",
  "description": ".NET bindings for PDF extraction, document operations and RAG chunking using the oxidize-pdf Rust core.",
  "branch": "main",
  "folders": [
    "docs/site"
  ],
  "excludeFolders": [
    "docs/reports",
    "docs/evidence",
    "docs/plans",
    "node_modules"
  ],
  "excludeFiles": [
    "AGENTS.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "PROJECT_PROGRESS.md",
    "README.md",
    "SECURITY.md",
    "SESSION_SUMMARY.md",
    "RELEASE-NOTES-v0.13.0.md",
    "RELEASE-NOTES-v0.14.0.md",
    "RELEASE-NOTES-v0.15.0.md",
    "RELEASE-NOTES-v0.16.0.md",
    "RELEASE-NOTES-v0.16.1.md",
    "RELEASE-NOTES-v0.17.0.md",
    "RELEASE-NOTES-v0.18.0.md",
    "RELEASE-NOTES-v0.19.0.md",
    "RELEASE-NOTES-v0.20.1.md",
    "RELEASE-NOTES-v0.20.2.md",
    "RELEASE-NOTES-v0.4.0.md",
    "RELEASE-NOTES-v0.5.0.md",
    "RELEASE-NOTES-v0.6.0.md",
    "TASKS.md",
    "CLAUDE.md"
  ],
  "rules": [
    "Use the .NET API documented for the installed package version.",
    "These guides target 0.20.2; do not assume develop-only changes are released."
  ]
}
